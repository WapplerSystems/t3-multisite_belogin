{
    "name": "wapplersystems/multisite-belogin",
    "type": "typo3-cms-extension",
    "description": "Cross site/domain backend login for TYPO3. It allows backend users to work in the frontend across domains.",
    "homepage": "https://github.com/WapplerSystems/t3-multisite_belogin",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "TYPO3",
        "extension",
        "multisite",
        "backend",
        "login",
        "cross domain"
    ],
    "authors": [
        {
            "name": "Sven Wappler",
            "email": "typo3@wappler.systems",
            "role": "Developer",
            "homepage": "https://wappler.systems"
        }
    ],
    "support": {
        "issues": "https://github.com/WapplerSystems/t3-multisite_belogin/issues",
        "source": "https://github.com/WapplerSystems/t3-multisite_belogin"
    },
    "require": {
        "typo3/cms-core": "^13.4.0"
    },
    "autoload": {
        "psr-4": {
            "WapplerSystems\\MultisiteBelogin\\": "Classes"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "multisite_belogin"
        }
    }
}